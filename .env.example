# Discord
DISCORD_BOT_TOKEN=
# Comma-separated user IDs allowed to interact with the bot
DISCORD_ALLOWED_USER_IDS=
# Channel ID where the bot logs activity (optional)
DISCORD_LOG_CHANNEL_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# DigitalOcean Spaces (S3-compatible)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=

# Database (path inside container; Railway mounts a volume here)
DATABASE_PATH=/data/bot.db

# Google Calendar OAuth (download from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/callback

# Encryption key for OAuth tokens at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# Optional features
ENABLE_MEDIA_OCR=true
ENABLE_AUDIO_TRANSCRIPTION=true

# Logging
LOG_LEVEL=INFO
